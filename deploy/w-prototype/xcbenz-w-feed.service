[Unit]
Description=Isolated XCBenz CH1 and CH2 vertical velocity feeds
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/xcbenz-w-prototype
ExecStart=/bin/sh /root/xcbenz-w-prototype/deploy/w-prototype/run_models.sh
ExecStopPost=/bin/sh /root/xcbenz-w-prototype/deploy/w-prototype/stop_models.sh
SuccessExitStatus=75
TimeoutStartSec=30min
TimeoutStopSec=50s
UMask=0022
