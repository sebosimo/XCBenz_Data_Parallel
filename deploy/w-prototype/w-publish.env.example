# Host-only publisher configuration. Copy outside the checkout with mode 0600.
INFOMANIAK_HOST=replace-with-existing-forecast-host
INFOMANIAK_USER=replace-with-existing-forecast-user
INFOMANIAK_DATA_ROOT=sites/data.xcbenz.com
INFOMANIAK_SSH_KEY_PATH=/root/xcbenz-forecast-secrets/infomaniak_data_deploy_key
INFOMANIAK_KNOWN_HOSTS_PATH=/root/xcbenz-forecast-secrets/infomaniak_known_hosts
DATA_HOST_BASE_URL=https://data.xcbenz.com
DEPLOY_ACCOUNT_QUOTA_BYTES=250000000000
