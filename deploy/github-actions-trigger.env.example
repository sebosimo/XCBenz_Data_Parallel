# Copy to /etc/xcbenz/github-actions-trigger.env on the server.
# Keep the real file owned by root and mode 600.

XCBENZ_GITHUB_TOKEN=github_pat_replace_me
XCBENZ_GITHUB_REPOSITORY=sebosimo/XCBenz_Data_Parallel
XCBENZ_GITHUB_WORKFLOW=daily_plot.yml
XCBENZ_GITHUB_REF=main

# The 30-minute scheduler should let preflight skip unchanged data, then deploy
# to data.xcbenz.com only when there is new work to publish.
XCBENZ_RUN_MODE=standard-deploy-data-host
