# Staging-only Infomaniak configuration for spatial value tiles.
#
# This file is intentionally not uploaded by deploy_data_infomaniak.sh. Apply
# it only to an explicitly approved non-production staging root, then run the
# remote validator before considering a production configuration change.

Options -Indexes

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
  Header set Access-Control-Allow-Headers "Origin, Range, Accept, Content-Type"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

AddType application/json .json
AddType application/geo+json .geojson
AddType application/octet-stream .bin .xvt

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/value-tiles-staging/web_exports/(live_stations/(latest|manifest)\.json|webcams/(latest|catalog)\.json|webcams/history/index\.json|webcams/thumbs/[^/]+\.jpg)$" xcbenz_live_no_cache=1
  SetEnvIf Request_URI "^/value-tiles-staging/web_exports/value_tiles/v1/[^/]+/[^/]+/[0-9a-f]{12}/" xcbenz_value_tile_immutable=1
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json application/geo+json application/octet-stream
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS application/json application/geo+json application/octet-stream
</IfModule>

<IfModule mod_headers.c>
  Header merge Vary Accept-Encoding

  <FilesMatch "\.(bin|xvt|json|geojson)$">
    Header set Cache-Control "public, max-age=3600" env=!xcbenz_live_no_cache
    Header set Cache-Control "public, max-age=31536000, immutable" env=xcbenz_value_tile_immutable
  </FilesMatch>

  <FilesMatch "manifest(?:\.compact)?\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header set Cache-Control "no-cache, must-revalidate" env=xcbenz_live_no_cache
</IfModule>
