# Isolated beta2-only XWS2 artifact delivery.
#
# This directory is outside production web_exports and is never referenced by
# the production root manifest. The beta2 frontend requires an explicit query
# opt-in before requesting these files.

Options -Indexes

AddType application/json .json
AddType application/octet-stream .xws

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
  Header set Access-Control-Allow-Headers "Origin, Accept, Content-Type"
  Header set X-Content-Type-Options "nosniff"
  Header merge Vary Accept-Encoding

  <FilesMatch "\.xws$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^H[0-9]{2}\.json$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "manifest\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json application/octet-stream
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS application/json application/octet-stream
</IfModule>
