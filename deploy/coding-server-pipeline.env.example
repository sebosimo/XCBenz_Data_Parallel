# Copy to /etc/xcbenz/coding-server-forecast.env on the coding server.
# Keep the real file owned by root and mode 600.

XCBENZ_RUN_MODE=standard-deploy-data-host
XCBENZ_PYTHON_CMD="uv run python"
GITHUB_REPOSITORY=sebosimo/XCBenz_Data_Parallel
DATA_BRANCH=data-web

DATA_HOST_BASE_URL=https://data.xcbenz.com
WEB_EXPORT_DATA_ROOT=https://data.xcbenz.com

# Keep false until the dual-publish activation gate. Production activation must
# set the matching GitHub Actions repository variable at the same time.
ENABLE_VALUE_TILES=false

# Per-process GRIB download fanout inside each fetch worker.
DOWNLOAD_WORKERS=6

# Local fetch layout and process fanout. `combined` writes map and profile
# products from the same horizon chunk worker, reducing duplicate downloads.
# Use `split` to compare against the GitHub-Actions-style map/profile split.
XCBENZ_JOB_LAYOUT=combined

# Start conservatively on the coding server. Combined max-jobs 4 was the best
# measured balance between fetch speed and interactive server responsiveness.
XCBENZ_LOCAL_MAX_JOBS=4
XCBENZ_LOCAL_MAX_CPU_PERCENT=88
XCBENZ_LOCAL_MAX_LOAD_PERCENT=110
XCBENZ_LOCAL_MIN_AVAILABLE_MB=4096
XCBENZ_RESOURCE_SAMPLE_SECONDS=15
XCBENZ_LOCAL_LOCK_FILE=/run/lock/xcbenz-coding-server-forecast.lock

# Cheap scheduler wrapper. The systemd timer calls the poller every 5 minutes;
# the poller exits quickly unless a fresh complete CH1/CH2 run pair exists.
XCBENZ_POLL_STATE_FILE=/opt/xcbenz/XCBenz_Data_Parallel/.local_pipeline/production_poller_state.json
XCBENZ_POLL_LOCK_FILE=/run/lock/xcbenz-coding-server-poller.lock
XCBENZ_POLL_PROBE_TIMEOUT=12
XCBENZ_POLL_RETRY_MINUTES=10
XCBENZ_POLL_NO_RESTORE_WEB_EXPORTS=true

# Infomaniak is the production source of truth. Keep data-web single-writer
# during the dual-publisher rollout; GitHub refreshes it when fallback runs.
XCBENZ_PUSH_DATA_BRANCH=false
XCBENZ_RESTORE_WEB_EXPORTS=false

# Keep uv/cache writes inside the repo path allowed by the systemd unit.
UV_CACHE_DIR=/opt/xcbenz/XCBenz_Data_Parallel/.uv-cache
XDG_CACHE_HOME=/opt/xcbenz/XCBenz_Data_Parallel/.cache

# Data-host deploy credentials. Prefer a key path on the server.
INFOMANIAK_HOST=replace_me
INFOMANIAK_PORT=22
INFOMANIAK_USER=replace_me
INFOMANIAK_DATA_ROOT=replace_me
INFOMANIAK_SSH_KEY_PATH=/etc/xcbenz/infomaniak_data_deploy_key

# Shared v1 publisher lease. Keep these compatible with XCBenz_Live_Data.
DEPLOY_LOCK_LEASE_SECONDS=900
DEPLOY_LOCK_HEARTBEAT_SECONDS=30
DEPLOY_LOCK_RECOVERY_GRACE_SECONDS=60
DEPLOY_LOCK_RELEASE_TIMEOUT_SECONDS=30
DEPLOY_LOCK_RECOVERY_ENABLED=true
DEPLOY_CANDIDATE_QUARANTINE_AFTER_SECONDS=604800
DEPLOY_CANDIDATE_DELETE_AFTER_SECONDS=1209600
