Options -Indexes

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
  Header set Access-Control-Allow-Headers "Origin, Range, Accept, Content-Type"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

AddType application/json .json
AddType application/geo+json .geojson
AddType application/octet-stream .bin .xvt

<IfModule mod_mime.c>
  # Keep .br strictly as content-coding metadata so the underlying
  # .bin/.xvt/.json/.geojson extension continues to own Content-Type.
  RemoveLanguage .br
  RemoveType .br
  AddEncoding br .br
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Never serve precompressed sidecars to byte-range requests (for example
  # float32 emagram profiles.bin slices): offsets address raw bytes.
  RewriteCond %{HTTP:Range} ^$
  RewriteCond %{HTTP:Accept-Encoding} \bbr\b [NC]
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+\.(?:bin|xvt|json|geojson))$ $1.br [QSA,L]
</IfModule>

<IfModule mod_setenvif.c>
  # Profile offsets address raw float32 bytes. Compressed ranges cannot be
  # decoded independently and do not have the same offsets as the raw data.
  SetEnvIfNoCase Range . no-gzip=1 no-brotli=1
  SetEnvIf Request_URI "^/web_exports/(live_stations/(latest|manifest)\.json|webcams/(latest|catalog)\.json|webcams/history/index\.json|webcams/thumbs/[^/]+\.jpg)$" xcbenz_live_no_cache=1
  SetEnvIf Request_URI "^/web_exports/value_tiles/v1/[^/]+/[^/]+/[0-9a-f]{12}/" xcbenz_value_tile_immutable=1
  SetEnvIf Request_URI "^/web_exports/(?:wind_maps|sunrain_maps|rain_maps|cloud_maps|sunshine_maps|emagrams|region_forecasts|thermal_panels)/[^/]+/[0-9]{8}_[0-9]{4}/" xcbenz_run_immutable=1
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json application/geo+json application/octet-stream
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS application/json application/geo+json application/octet-stream
</IfModule>

<IfModule mod_headers.c>
  Header merge Vary Accept-Encoding

  <FilesMatch "\.(bin|xvt|json|geojson)(?:\.br)?$">
    Header set Cache-Control "public, max-age=3600" env=!xcbenz_live_no_cache
    Header set Cache-Control "public, max-age=604800, immutable" env=xcbenz_run_immutable
    Header set Cache-Control "public, max-age=31536000, immutable" env=xcbenz_value_tile_immutable
  </FilesMatch>

  <FilesMatch "manifest(?:\.compact)?\.json(?:\.br)?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header set Cache-Control "no-cache, must-revalidate" env=xcbenz_live_no_cache
</IfModule>
