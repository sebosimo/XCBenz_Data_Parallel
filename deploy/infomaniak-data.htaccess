Options -Indexes

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
  Header set Access-Control-Allow-Headers "Origin, Range, Accept, Content-Type"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

AddType application/json .json
AddType application/geo+json .geojson
AddType application/octet-stream .bin

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json application/geo+json application/octet-stream
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS application/json application/geo+json application/octet-stream
</IfModule>

<IfModule mod_headers.c>
  Header merge Vary Accept-Encoding

  <FilesMatch "\.(bin|json|geojson)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  <FilesMatch "manifest\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
